{
  "name": "kwd-it/contextualwp-housebuilder-pack",
  "description": "Housebuilder sector pack for ContextualWP: relationship hints, interpretation, and ACF semantic field grouping.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Kirk Johnston",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "ContextualWP\\HousebuilderPack\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ContextualWP\\HousebuilderPack\\Tests\\": "tests/",
      "ContextualWP\\Helpers\\": "tests/stubs/Helpers/"
    },
    "files": [
      "tests/stubs/WP_Post.php",
      "tests/stubs/wp-plot-mapper-functions.php",
      "tests/stubs/wp-plots-rest-functions.php"
    ]
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}

